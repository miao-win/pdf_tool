QLabel#homeTitle {
    font-size: 32px;
    font-weight: bold;
    color: #1a365d;
}

QLabel#homeSubtitle {
    font-size: 16px;
    color: #4a5568;
    margin-bottom: 20px;
}

QLabel#dropHint {
    font-size: 14px;
    color: #718096;
    margin-top: 20px;
}

QLabel#infoLabel {
    font-size: 14px;
    color: #718096;
    padding: 20px;
}

QLabel#estimateLabel {
    font-size: 12px;
    color: #718096;
}

QPushButton#primaryBtn {
    background-color: #3182ce;
    color: white;
    border: none;
    padding: 12px 24px;
    font-size: 16px;
    border-radius: 6px;
    margin-top: 10px;
}

QPushButton#primaryBtn:hover {
    background-color: #4299e1;
}

QPushButton#primaryBtn:disabled {
    background-color: #a0aec0;
}

QPushButton#backBtn {
    background-color: transparent;
    border: none;
    color: #3182ce;
    font-size: 14px;
    padding: 8px;
}

QPushButton#backBtn:hover {
    color: #2b6cb0;
}

QGroupBox {
    font-weight: bold;
    margin-top: 12px;
}

QGroupBox::title {
    color: #2d3748;
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QLineEdit {
    padding: 8px;
    border: 1px solid #cbd5e0;
    border-radius: 4px;
    background: white;
    color: #1a202c;
}

QLineEdit:focus {
    border: 1px solid #3182ce;
}

QLineEdit:disabled {
    background-color: #edf2f7;
    color: #a0aec0;
}

QListWidget {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    color: #1a202c;
}

QProgressBar {
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    text-align: center;
    height: 20px;
    background: #f7fafc;
}

QProgressBar::chunk {
    background-color: #3182ce;
    border-radius: 3px;
}

QComboBox {
    padding: 8px;
    border: 1px solid #cbd5e0;
    border-radius: 4px;
    background: white;
    color: #1a202c;
}

QComboBox:hover {
    border: 1px solid #3182ce;
}

QRadioButton {
    padding: 4px;
    color: #2d3748;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QWidget {
    background-color: #f0f4f8;
    color: #1a202c;
}

QGroupBox {
    background-color: transparent;
    border: 1px solid #e2e8f0;
}
