:root {
    --primary-color: #2563EB;
    --primary-hover: #3B82F6;
    --primary-disabled: #94A3B8;
    --background: #F8FAFC;
    --surface: #FFFFFF;
    --surface-hover: #F1F5F9;
    --text-primary: #1E293B;
    --text-secondary: #64748B;
    --border-color: #E2E8F0;
    --border-focus: #2563EB;
    --danger-color: #EF4444;
    --danger-hover: #DC2626;
    --success-color: #22C55E;
    --shadow: rgba(0, 0, 0, 0.1);
}

* {
    font-family: "Microsoft YaHei UI", "PingFang SC", "Noto Sans CJK SC", sans-serif;
}

QLabel#homeTitle {
    font-size: 36px;
    font-weight: bold;
    color: var(--text-primary);
    padding: 20px 0 10px;
}

QLabel#homeSubtitle {
    font-size: 16px;
    color: var(--text-secondary);
    margin-bottom: 30px;
}

QLabel#dropHint {
    font-size: 14px;
    color: var(--text-secondary);
    margin-top: 30px;
}

QLabel#pageTitle {
    font-size: 24px;
    font-weight: bold;
    color: var(--text-primary);
    padding: 10px 0 5px;
}

QLabel#pageDesc {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 15px;
}

QLabel#infoLabel {
    font-size: 14px;
    color: var(--text-secondary);
    padding: 40px 20px;
    background: var(--surface);
    border: 2px dashed var(--border-color);
    border-radius: 8px;
}

QLabel#hintLabel {
    font-size: 12px;
    color: var(--text-secondary);
    font-style: italic;
}

QLabel#warningLabel {
    font-size: 13px;
    color: #B45309;
    background: #FEF3C7;
    padding: 10px 15px;
    border-radius: 6px;
    margin: 5px 0;
}

QLabel#estimateLabel {
    font-size: 12px;
    color: var(--text-secondary);
}

QLabel#pathLabel {
    font-size: 12px;
    color: var(--text-secondary);
}

QPushButton {
    background-color: var(--surface);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 8px 16px;
    font-size: 14px;
    border-radius: 6px;
    min-height: 32px;
}

QPushButton:hover {
    background-color: var(--surface-hover);
    border-color: var(--primary-color);
}

QPushButton#primaryBtn {
    background-color: var(--primary-color);
    color: white;
    border: none;
    padding: 10px 24px;
    font-size: 15px;
    font-weight: 500;
}

QPushButton#primaryBtn:hover {
    background-color: var(--primary-hover);
}

QPushButton#primaryBtn:disabled {
    background-color: var(--primary-disabled);
    color: white;
}

QPushButton#dangerBtn {
    background-color: var(--danger-color);
    color: white;
    border: none;
}

QPushButton#dangerBtn:hover {
    background-color: var(--danger-hover);
}

QPushButton#backBtn {
    background-color: transparent;
    border: none;
    color: var(--primary-color);
    font-size: 14px;
    padding: 8px;
}

QPushButton#backBtn:hover {
    color: var(--primary-hover);
    background: transparent;
}

QPushButton#themeToggle {
    background-color: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    font-size: 18px;
}

QPushButton#themeToggle:hover {
    background-color: var(--surface-hover);
}

QGroupBox {
    font-weight: bold;
    font-size: 14px;
    margin-top: 15px;
    padding-top: 10px;
}

QGroupBox::title {
    color: var(--text-primary);
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 8px;
}

QGroupBox {
    background-color: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 15px 10px 10px;
}

QLineEdit {
    padding: 10px 12px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text-primary);
    font-size: 14px;
    min-height: 32px;
}

QLineEdit:focus {
    border: 2px solid var(--primary-color);
    padding: 9px 11px;
}

QLineEdit:disabled {
    background-color: var(--surface-hover);
    color: var(--text-secondary);
}

QLineEdit::placeholder {
    color: var(--text-secondary);
}

QListWidget {
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-primary);
    padding: 5px;
}

QListWidget::item {
    padding: 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background: var(--primary-color);
    color: white;
}

QListWidget::item:hover {
    background: var(--surface-hover);
}

QProgressBar {
    border: none;
    border-radius: 3px;
    text-align: center;
    height: 6px;
    background: var(--border-color);
}

QProgressBar::chunk {
    background-color: var(--primary-color);
    border-radius: 3px;
}

QComboBox {
    padding: 8px 12px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text-primary);
    font-size: 14px;
    min-height: 32px;
}

QComboBox:hover {
    border: 1px solid var(--primary-color);
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid var(--text-secondary);
    margin-right: 10px;
}

QRadioButton {
    padding: 6px 4px;
    color: var(--text-primary);
    font-size: 14px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid var(--border-color);
}

QRadioButton::indicator:checked {
    background: var(--primary-color);
    border: 2px solid var(--primary-color);
}

QCheckBox {
    padding: 6px 4px;
    color: var(--text-primary);
    font-size: 14px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid var(--border-color);
}

QCheckBox::indicator:checked {
    background: var(--primary-color);
    border: 2px solid var(--primary-color);
}

QWidget {
    background-color: var(--background);
    color: var(--text-primary);
}
